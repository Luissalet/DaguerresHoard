{
  "schema": 1,
  "id": "argus",
  "name": "Argus's Hoard",
  "purpose": "Lets the assistant search, look at and organize the owner's local photo library by content, place and time.",
  "capabilities": ["photo search", "visual similarity", "duplicate detection", "EXIF and places", "albums", "contact sheets"],
  "placeholders": ["ARGUS_DIR", "APP_URL"],
  "defaults": {"APP_URL": "http://127.0.0.1:8814"},
  "app": {
    "url_default": "http://127.0.0.1:8814",
    "ui_url": "{APP_URL}",
    "health": {"path": "/api/health", "expect": {"service": "argus-hoard"}},
    "identify": {"service": ["argus-hoard"], "title": ["argus's hoard"]},
    "launch_hint": {
      "kind": "process",
      "executable": "{ARGUS_DIR}/.venv/Scripts/python.exe",
      "argv": ["-m", "argus_hoard", "--no-browser"],
      "cwd": "{ARGUS_DIR}",
      "readiness": {"url": "{APP_URL}/api/health", "timeout_s": 30}
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{ARGUS_DIR}/.venv/Scripts/python.exe",
    "args": ["{ARGUS_DIR}/argus_hoard/mcp_server.py"],
    "env": {"ARGUS_URL": "{APP_URL}"},
    "optional_env": []
  },
  "provides": {"skills": ["skills/find-photos/SKILL.md"]},
  "notes": "Indexes local photo folders with CLIP embeddings and hands the model compact search results plus contact-sheet images. Never modifies, moves or deletes originals."
}
