{
  "schema": 1,
  "id": "daguerre",
  "name": "Daguerre's Hoard",
  "purpose": "Lets the assistant search, look at and organize the user's local photo library by content, place and time.",
  "capabilities": [
    "photo search",
    "visual similarity",
    "duplicate detection",
    "EXIF and places",
    "albums",
    "contact sheets",
    "incorporated Daguerre layered-image and development engines",
    "editable layered raster projects",
    "ordered local gallery export",
    "ratings, labels, keywords and retouch recipes with standard XMP sidecars"
  ],
  "placeholders": [
    "DAGUERRE_DIR",
    "APP_URL",
    "TOKEN_FILE",
    "DATA_DIR",
    "PYTHON"
  ],
  "defaults": {
    "APP_URL": "http://127.0.0.1:8814",
    "DATA_DIR": "{DAGUERRE_DIR}/data",
    "TOKEN_FILE": "{DAGUERRE_DIR}/data/mcp-token",
    "PYTHON": "{DAGUERRE_DIR}/.venv/Scripts/python.exe"
  },
  "app": {
    "url_default": "http://127.0.0.1:8814",
    "ui_url": "{APP_URL}",
    "health": {
      "path": "/api/health",
      "expect": {
        "service": "daguerres-hoard"
      }
    },
    "identify": {
      "service": [
        "daguerres-hoard"
      ],
      "title": [
        "daguerre's hoard"
      ]
    },
    "launch_hint": {
      "kind": "process",
      "executable": "{PYTHON}",
      "argv": [
        "-I",
        "-m",
        "daguerre_hoard",
        "--no-browser",
        "--data-dir",
        "{DATA_DIR}"
      ],
      "cwd": "{DAGUERRE_DIR}",
      "readiness": {
        "url": "{APP_URL}/api/health",
        "timeout_s": 30
      },
      "env": {
        "DAGUERRE_DATA_DIR": "{DATA_DIR}",
        "DAGUERRE_TOKEN_FILE": "{TOKEN_FILE}"
      }
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{PYTHON}",
    "args": [
      "-I",
      "-m",
      "daguerre_hoard.mcp_server"
    ],
    "env": {
      "DAGUERRE_URL": "{APP_URL}",
      "DAGUERRE_DATA_DIR": "{DATA_DIR}",
      "DAGUERRE_TOKEN_FILE": "{TOKEN_FILE}"
    },
    "optional_env": []
  },
  "x-family": {
    "copilot": true
  },
  "provides": {
    "skills": {"slugs": ["photo-library-curation", "image-composition", "revision-aware-media"], "limit": 3}
  },
  "notes": "Indexes local photo folders with CLIP embeddings and hands the model compact search results plus contact-sheet images. Never modifies, moves or deletes originals.",
  "skills": {"slugs": ["photo-library-curation", "image-composition", "revision-aware-media"], "limit": 3}
}
